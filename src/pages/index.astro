---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import StatsCounter from "../components/StatsCounter.astro";
import SocialCard from "../components/SocialCard.astro";
import AcademicAreas from "../components/AcademicAreas.astro";
import InstagramFeed from "../components/InstagramFeed.astro";
import QuickFaq from "../components/QuickFaq.astro";
import Footer from "../components/Footer.astro";
import { socialLinks, university } from "../data/socials";
---

<Base
  title="UNEFM · Portal Oficial de Redes Sociales y Accesos Universitarios"
  description={`Portal oficial de la ${university.name}. Accesos a control de estudios, pregrado, postgrado, campus virtual EAD y redes sociales.`}
>
  <!-- Main Header Navigation -->
  <Header />

  <main class="flex-grow">
    <!-- Hero Section (Bright & Corporate featuring /hero.png) -->
    <section class="relative min-h-[580px] lg:min-h-[640px] flex items-center justify-center overflow-hidden py-12 lg:py-20 bg-gradient-to-b from-blue-50/80 via-white to-slate-50 border-b border-slate-200">
      <!-- Hero Background Image (/hero.png) -->
      <div class="absolute inset-0 z-0 opacity-40">
        <img
          src="/hero.png"
          alt="Sede UNEFM"
          class="w-full h-full object-cover object-center filter saturate-120"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-50 via-white/70 to-blue-50/50"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-50 via-white/80 to-transparent"></div>
      </div>

      <!-- Hero Grid Content -->
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <!-- Left Column: Hero Text & Actions -->
          <div class="lg:col-span-7 text-center sm:text-left">
            <!-- Institutional Badge -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 border border-blue-300 text-blue-950 text-xs font-extrabold tracking-wider uppercase mb-6 shadow-xs">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
              <span>Portal Institucional Integrado</span>
            </div>

            <!-- Main Title -->
            <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-slate-900 leading-[1.12] tracking-tight mb-6">
              Universidad Nacional Experimental <br />
              <span class="text-gradient-blue">Francisco de Miranda</span>
            </h1>

            <!-- Tagline -->
            <p class="text-slate-700 text-base sm:text-lg font-normal leading-relaxed max-w-2xl mb-8">
              Conectados con la excelencia académica, la innovación científica y el desarrollo de nuestra comunidad. Accede a nuestros portales oficiales y redes sociales en un solo sitio.
            </p>

            <!-- Hero Action Buttons -->
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4">
              <a
                href="#redes"
                class="px-6 py-3.5 rounded-xl font-bold text-sm sm:text-base bg-blue-700 hover:bg-blue-800 text-white shadow-xl shadow-blue-700/25 hover:scale-[1.02] transition-all flex items-center gap-2 border border-blue-600"
              >
                <span>Explorar Canales & Portales</span>
                <svg class="w-5 h-5 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <a
                href="http://estudiantes.unefm.edu.ve"
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-3.5 rounded-xl font-bold text-sm sm:text-base bg-white text-blue-950 border border-slate-300 hover:bg-blue-50 hover:border-blue-400 transition-all flex items-center gap-2 shadow-xs font-semibold"
              >
                <svg class="w-5 h-5 text-blue-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                </svg>
                <span>Control de Estudios</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Prominent Hero Image Showcase Card (/hero.png) -->
          <div class="lg:col-span-5 relative">
            <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-blue-900/20 border-4 border-white bg-white group hover:scale-[1.01] transition-transform duration-300">
              <img
                src="/hero.png"
                alt="Sede Principal UNEFM"
                class="w-full h-[320px] sm:h-[380px] object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              
              <!-- Image Caption Badge -->
              <div class="absolute bottom-4 left-4 right-4 p-3.5 rounded-xl bg-white/95 backdrop-blur-md border border-slate-200 shadow-lg flex items-center justify-between gap-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center shrink-0 font-bold border border-blue-200">
                    <svg class="w-5 h-5 text-blue-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V5" />
                    </svg>
                  </div>
                  <div>
                    <div class="font-display font-extrabold text-xs text-slate-900">Sede Principal UNEFM</div>
                    <div class="text-[11px] text-slate-500 font-medium">Santa Ana de Coro, Falcón</div>
                  </div>
                </div>
                <span class="text-[10px] font-bold px-2 py-1 rounded bg-amber-100 text-amber-900 border border-amber-300 uppercase shrink-0">
                  Patrimonio
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Institutional Stats Bar -->
    <StatsCounter />

    <!-- Social Links & Academic Portals Section -->
    <section id="redes" class="py-16 sm:py-24 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-900 border border-blue-200 uppercase tracking-widest mb-3">
              🌐 Ecosistema Digital
            </span>
            <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
              Canales Oficiales & <span class="text-gradient-blue">Portales Web</span>
            </h2>
            <p class="mt-2 text-slate-600 text-sm max-w-xl">
              Plataformas institucionales verificadas para estudiantes, docentes, investigadores y la comunidad general de la UNEFM.
            </p>
          </div>

          <!-- Category Filter Tabs -->
          <div class="flex flex-wrap items-center gap-1.5 p-1.5 rounded-2xl bg-white border border-slate-200 shadow-sm self-start md:self-auto" id="filter-container">
            <button
              data-filter="all"
              class="filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-bold bg-blue-700 text-white transition-all shadow-sm"
            >
              Todos ({socialLinks.length})
            </button>
            <button
              data-filter="social"
              class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-blue-900 hover:bg-slate-100 transition-all"
            >
              📲 Redes
            </button>
            <button
              data-filter="academic"
              class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-blue-900 hover:bg-slate-100 transition-all"
            >
              🎓 Académico
            </button>
            <button
              data-filter="student"
              class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-blue-900 hover:bg-slate-100 transition-all"
            >
              👨‍🎓 Alumnos
            </button>
            <button
              data-filter="media"
              class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-blue-900 hover:bg-slate-100 transition-all"
            >
              📻 Medios
            </button>
          </div>
        </div>

        <!-- Social Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="social-grid">
          {socialLinks.map((link) => (
            <div data-category={link.category} class="social-item-card transition-all duration-300">
              <SocialCard link={link} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Academic Areas Section -->
    <AcademicAreas />

    <!-- Instagram Live Feed Section -->
    <InstagramFeed />

    <!-- FAQ Section -->
    <QuickFaq />
  </main>

  <!-- Corporate Footer -->
  <Footer />
</Base>

<!-- Interactive Category Filter Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.social-item-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active tab style
        buttons.forEach((b) => {
          b.classList.remove('bg-blue-700', 'text-white', 'shadow-sm');
          b.classList.add('text-slate-600', 'hover:text-blue-900');
        });

        btn.classList.add('bg-blue-700', 'text-white', 'shadow-sm');
        btn.classList.remove('text-slate-600', 'hover:text-blue-900');

        // Filter cards
        items.forEach((item) => {
          const category = item.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            (item as HTMLElement).style.display = 'block';
            (item as HTMLElement).style.opacity = '1';
          } else {
            (item as HTMLElement).style.display = 'none';
            (item as HTMLElement).style.opacity = '0';
          }
        });
      });
    });
  });
</script>
