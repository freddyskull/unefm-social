---
import { university } from '../data/socials';
---

<div class="relative z-20 -mt-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 shadow-xl shadow-blue-900/10">
    <!-- Stat 1 -->
    <div class="flex items-center gap-4 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
      <div class="w-12 h-12 rounded-xl bg-blue-100 border border-blue-200 flex items-center justify-center text-blue-700 shrink-0">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <div class="font-display font-black text-2xl sm:text-3xl text-slate-900">48+</div>
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Años de Historia</div>
      </div>
    </div>

    <!-- Stat 2 -->
    <div class="flex items-center gap-4 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
      <div class="w-12 h-12 rounded-xl bg-amber-100 border border-amber-200 flex items-center justify-center text-amber-700 shrink-0">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V5" />
        </svg>
      </div>
      <div>
        <div class="font-display font-black text-2xl sm:text-3xl text-amber-600">5</div>
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Áreas Decanales</div>
      </div>
    </div>

    <!-- Stat 3 -->
    <div class="flex items-center gap-4 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
      <div class="w-12 h-12 rounded-xl bg-blue-100 border border-blue-200 flex items-center justify-center text-blue-700 shrink-0">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <div>
        <div class="font-display font-black text-2xl sm:text-3xl text-slate-900">{university.studentsCount}</div>
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Comunidad Estudiantil</div>
      </div>
    </div>

    <!-- Stat 4 -->
    <div class="flex items-center gap-4 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
      <div class="w-12 h-12 rounded-xl bg-emerald-100 border border-emerald-200 flex items-center justify-center text-emerald-700 shrink-0">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
        </svg>
      </div>
      <div>
        <div class="font-display font-black text-2xl sm:text-3xl text-emerald-700">+1.560</div>
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Nuevos Profesionales</div>
      </div>
    </div>
  </div>
</div>
