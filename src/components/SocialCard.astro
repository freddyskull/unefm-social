---
import type { SocialLink } from '../data/types';
import Icon from './Icon.astro';

interface Props {
  link: SocialLink;
}

const { link } = Astro.props;

const categoryBadges: Record<string, { label: string; class: string }> = {
  social: { label: 'Red Social', class: 'bg-purple-100 text-purple-800 border-purple-200' },
  student: { label: 'Alumnos', class: 'bg-blue-100 text-blue-900 border-blue-200' },
  academic: { label: 'Academia', class: 'bg-emerald-100 text-emerald-900 border-emerald-200' },
  media: { label: 'Medios', class: 'bg-rose-100 text-rose-900 border-rose-200' },
  all: { label: 'Oficial', class: 'bg-slate-100 text-slate-800 border-slate-200' },
};

const badgeInfo = categoryBadges[link.category] || categoryBadges.all;
---

<div class="glass-card group relative p-6 rounded-2xl flex flex-col justify-between h-full bg-white border border-slate-200 hover:border-blue-500 transition-all duration-300 shadow-sm hover:shadow-xl hover:shadow-blue-900/10">
  <div>
    <!-- Card Header: Icon & Category Badge -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-700 group-hover:scale-110 group-hover:text-white group-hover:bg-blue-700 transition-all duration-300 shadow-xs">
        <Icon name={link.icon} class="w-6 h-6" />
      </div>
      <div class="flex items-center gap-2">
        {link.badge && (
          <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300">
            {link.badge}
          </span>
        )}
        <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full border uppercase tracking-wider ${badgeInfo.class}`}>
          {badgeInfo.label}
        </span>
      </div>
    </div>

    <!-- Card Content -->
    <h3 class="font-display font-extrabold text-lg text-slate-900 group-hover:text-blue-800 transition-colors flex items-center gap-1.5 mb-1">
      <span>{link.name}</span>
      <svg class="w-4 h-4 text-blue-600 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </h3>

    <div class="text-xs font-bold text-blue-700 font-mono mb-3 tracking-wide flex items-center gap-1">
      <span>{link.handle}</span>
    </div>

    <p class="text-xs text-slate-600 leading-relaxed line-clamp-3 mb-6">
      {link.description}
    </p>
  </div>

  <!-- Card Action Button -->
  <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
    <span class="text-xs font-semibold text-slate-500 flex items-center gap-1">
      <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Canal Verificado
    </span>

    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-xs font-bold bg-blue-700 text-white group-hover:bg-blue-800 transition-all shadow-sm shadow-blue-700/20"
    >
      <span>Visitar</span>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</div>