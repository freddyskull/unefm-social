---
const faqs = [
  {
    q: "¿Cómo ingreso al Portal de Control de Estudios (Alumnos)?",
    a: "Puedes ingresar directamente a través del enlace de 'Control de Estudios' en la sección de Accesos Universitarios o visitando directamente estudiantes.unefm.edu.ve con tu cédula y clave registrada."
  },
  {
    q: "¿Dónde consulto la oferta académica y fechas de inscripción de Pregrado?",
    a: "La oferta académica, calendarios semestrales y requisitos de admisión para nuevos ingresos se publican periódicamente en el portal pregrado.unefm.net y a través del Instagram Oficial @unefmoficial."
  },
  {
    q: "¿Qué es el Campus Virtual EAD UNEFM y cómo acceder?",
    a: "Es la plataforma de Educación a Distancia de la UNEFM (ead.unefm.edu.ve), diseñada para clases semipresenciales y virtuales de pregrado y postgrado."
  },
  {
    q: "¿Dónde queda la sede principal del Rectorado de la UNEFM?",
    a: "La sede rectoral principal se encuentra ubicada en la Calle Falcón, Edificio Rectorado UNEFM, en el centro histórico de Santa Ana de Coro, Estado Falcón, Venezuela."
  }
];
---

<section id="preguntas" class="py-16 sm:py-24 relative z-10 bg-slate-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-900 border border-blue-200 uppercase tracking-widest mb-3">
        ❓ Orientación al Estudiante
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Preguntas Frecuentes <span class="text-gradient-blue">UNEFM</span>
      </h2>
      <p class="mt-2 text-slate-600 text-sm">
        Respuesta rápida a las consultas más comunes de estudiantes, egresados y aspirantes.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="glass-card rounded-2xl bg-white border border-slate-200 group overflow-hidden shadow-xs hover:border-blue-500 transition-all">
          <summary class="p-5 flex items-center justify-between gap-4 cursor-pointer select-none font-display font-bold text-base text-slate-900 group-hover:text-blue-800 transition-colors">
            <span class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-lg bg-blue-100 text-blue-800 text-xs font-extrabold flex items-center justify-center shrink-0 border border-blue-200">
                0{i + 1}
              </span>
              <span>{faq.q}</span>
            </span>
            <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 pb-5 pt-1 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
