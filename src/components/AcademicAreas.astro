---
import { academicAreas } from '../data/socials';
---

<section id="areas" class="py-16 sm:py-24 relative overflow-hidden bg-white border-y border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300 uppercase tracking-widest mb-3">
        🎓 Excelencia Académica
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Áreas de Conocimiento <span class="text-gradient-blue">UNEFM</span>
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
        La Universidad Francisco de Miranda ofrece formación profesional en 5 grandes áreas decanales para el desarrollo científico y social del país.
      </p>
    </div>

    <!-- Academic Areas Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {academicAreas.map((area) => (
        <div class="glass-card p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-500 flex flex-col justify-between group shadow-sm hover:shadow-xl hover:shadow-blue-900/10">
          <div>
            <!-- Header Badges -->
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-extrabold bg-blue-100 text-blue-900 border border-blue-200">
                {area.code}
              </span>
              <span class="text-xs text-slate-500 font-semibold">
                Área Decanal
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="font-display font-extrabold text-xl text-slate-900 group-hover:text-blue-800 transition-colors mb-2">
              {area.name}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              {area.description}
            </p>

            <!-- Careers Pills -->
            <div class="mb-6">
              <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-2">
                Programas y Carreras:
              </span>
              <div class="flex flex-wrap gap-1.5">
                {area.careers.map((career) => (
                  <span class="text-[11px] px-2.5 py-1 rounded-lg bg-slate-100 text-slate-800 font-medium border border-slate-200">
                    {career}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Card Footer Button -->
          <a
            href="https://pregrado.unefm.net"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-2.5 px-4 rounded-xl text-xs font-bold bg-slate-100 hover:bg-blue-700 hover:text-white text-slate-800 text-center transition-all flex items-center justify-center gap-1.5 border border-slate-200 shadow-xs"
          >
            <span>Ver Pensum y Requisitos</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      ))}

      <!-- Special Postgrado Card -->
      <div class="glass-card p-6 rounded-2xl border border-blue-300 hover:border-blue-400 bg-gradient-to-br from-blue-900 via-blue-800 to-indigo-900 text-white flex flex-col justify-between shadow-xl shadow-blue-900/20">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-1 rounded-md text-xs font-mono font-extrabold bg-amber-400 text-slate-950">
              POSTGRADO
            </span>
            <span class="text-xs text-blue-200 font-semibold">
              4to Nivel
            </span>
          </div>

          <h3 class="font-display font-extrabold text-xl text-white mb-2">
            Decanato de Postgrado
          </h3>
          <p class="text-xs text-blue-100 leading-relaxed mb-4">
            Programas de maestría, especialidades médicas e ingenieriles, doctorados y diplomados de excelencia investigativa.
          </p>

          <div class="space-y-2 mb-6 text-xs text-blue-200">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Maestrías en Ciencias e Ingenierías</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Especialidades Clínicas y Asistenciales</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Doctorados en Ciencia y Educación</span>
            </div>
          </div>
        </div>

        <a
          href="https://postgrado.unefm.net"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full py-2.5 px-4 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 text-center transition-all flex items-center justify-center gap-1.5 shadow-md shadow-amber-500/20"
        >
          <span>Portal Postgrado UNEFM</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
